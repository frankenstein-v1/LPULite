SIM ?= icarus
TOPLEVEL_LANG ?= verilog

TB_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
REPO_ROOT := $(abspath $(TB_DIR)/..)
PATH := $(REPO_ROOT)/.venv_cocotb13/bin:$(PATH)
COCOTB_CONFIG ?= $(if $(wildcard $(REPO_ROOT)/.venv_cocotb13/bin/cocotb-config),$(REPO_ROOT)/.venv_cocotb13/bin/cocotb-config,cocotb-config)

VERILOG_SOURCES = $(REPO_ROOT)/src/cvfpu_fp8_to_fp32_cast.sv \
                  $(REPO_ROOT)/src/cvfpu_fp32_addsub.sv \
                  $(REPO_ROOT)/src/cvfpu_fp32_div.sv \
                  $(REPO_ROOT)/src/cvfpu_fp32_cmp.sv \
                  $(REPO_ROOT)/src/cvfpu_fp32_fma.sv \
                  $(REPO_ROOT)/src/cvfpu_fp32_sqrt.sv \
                  $(REPO_ROOT)/src/lut_rmsnorm.sv \
                  $(REPO_ROOT)/src/rmsnorm.sv \
                  $(REPO_ROOT)/src/vxm_rope.sv \
                  $(REPO_ROOT)/src/residual_add.sv \
                  $(REPO_ROOT)/src/vxm.sv \
                  $(REPO_ROOT)/src/row_fifo.sv \
                  $(REPO_ROOT)/src/softmax.sv \
                  $(REPO_ROOT)/src/quant.sv \
                  $(REPO_ROOT)/src/exp.sv \
                  $(REPO_ROOT)/src/divider.sv

TOPLEVEL = vxm
COCOTB_TEST_MODULES = vxm_tb

export PYTHONPATH := $(TB_DIR):$(PYTHONPATH)
export WAVES = 1

include $(shell $(COCOTB_CONFIG) --makefiles)/Makefile.sim
