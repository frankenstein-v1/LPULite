SIM ?= verilator
TOPLEVEL_LANG ?= verilog

PWD := $(shell pwd)
ROOT := $(PWD)/..
CVFPU := $(ROOT)/third_party/cvfpu
COMMON := $(CVFPU)/src/common_cells/src
DIVSQRT := $(CVFPU)/src/fpu_div_sqrt_mvp/hdl

include $(PWD)/cvfpu_sources.mk

VERILOG_SOURCES = \
	$(CVFPU_ALL_SOURCES) \
	$(ROOT)/src/lpu_pkg.sv \
	$(ROOT)/src/cvfpu_fp8_fp32_fma.sv \
	$(ROOT)/src/mac.sv \
	$(ROOT)/src/int_mac.sv \
	$(ROOT)/src/cvfpu_fp8_to_fp32_cast.sv \
	$(ROOT)/src/cvfpu_fp32_fma.sv \
	$(ROOT)/src/acc.sv \
	$(ROOT)/src/mem.sv \
	$(ROOT)/src/mxm.sv \
	$(ROOT)/src/sxm.sv \
	$(ROOT)/src/row_fifo.sv \
	$(ROOT)/src/lut_softmax_exp.sv \
	$(ROOT)/src/lut_softmax_div.sv \
	$(ROOT)/src/softmax.sv \
	$(ROOT)/src/softmax_chunked.sv \
	$(ROOT)/src/quant.sv \
	$(ROOT)/src/lut_rmsnorm.sv \
	$(ROOT)/src/vxm_rope.sv \
	$(ROOT)/src/residual_add.sv \
	$(ROOT)/src/vxm.sv \
	$(ROOT)/src/icu.sv \
	$(ROOT)/src/shared_bus_mux.sv \
	$(ROOT)/src/westbound_bus/westbound_bus.sv \
	$(ROOT)/src/westbound_bus/westbound_consumer_decode.sv \
	$(ROOT)/src/eastbound_bus/eastbound_bus.sv \
	$(ROOT)/src/eastbound_bus/eastbound_consumer_decode.sv \
	$(ROOT)/src/eastbound_bus/mxm_eastbound_adapter.sv \
	$(ROOT)/src/lpu.sv \
	$(PWD)/LPU_tb.sv

TOPLEVEL = lpu_cocotb_top
COCOTB_TEST_MODULES = lpu_tb

COMPILE_ARGS += -DHAVE_CVFPU
COMPILE_ARGS += -I$(CVFPU)/src/common_cells/include
EXTRA_ARGS += --Wno-fatal
EXTRA_ARGS += --trace-vcd
SIM_ARGS += --trace
SIM_ARGS += --trace-file $(SIM_BUILD)/lpu_fp_mxm.vcd

export WAVES = 1

include $(shell cocotb-config --makefiles)/Makefile.sim
