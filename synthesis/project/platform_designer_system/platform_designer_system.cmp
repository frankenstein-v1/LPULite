	component platform_designer_system is
		port (
			clk_clk                  : in  std_logic                     := 'X';             -- clk
			lpu_avalon_address       : out std_logic_vector(31 downto 0);                    -- address
			lpu_avalon_readdata      : in  std_logic_vector(31 downto 0) := (others => 'X'); -- readdata
			lpu_avalon_read          : out std_logic;                                        -- read
			lpu_avalon_write         : out std_logic;                                        -- write
			lpu_avalon_writedata     : out std_logic_vector(31 downto 0);                    -- writedata
			lpu_avalon_waitrequest   : in  std_logic                     := 'X';             -- waitrequest
			lpu_avalon_readdatavalid : in  std_logic                     := 'X';             -- readdatavalid
			lpu_avalon_byteenable    : out std_logic_vector(3 downto 0);                     -- byteenable
			reset_reset_n            : in  std_logic                     := 'X'              -- reset_n
		);
	end component platform_designer_system;

