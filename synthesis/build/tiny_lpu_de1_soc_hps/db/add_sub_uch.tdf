--synthesis_resources = lut 12 
SUBDESIGN add_sub_uch
( 
	cin	:	input;
	dataa[11..0]	:	input;
	datab[11..0]	:	input;
	result[11..0]	:	output;
) 
VARIABLE
	result_int[12..0]	:	WIRE;
BEGIN 
	result_int[] = (dataa[], cin) + (datab[], cin);
	result[] = result_int[12..1];
END;
--VALID FILE
